# Network Configuration
# Options: undeployed (local devnet), preview, preprod
VITE_NETWORK=undeployed

# Contract Address (leave empty for local devnet, populate after deployment)
VITE_CONTRACT_ADDRESS=

# Proof Server URL (for local devnet)
VITE_PROOF_SERVER_URL=http://localhost:6300

# For public networks, you can override these:
# MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql
# MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
# MIDNIGHT_PROOF_SERVER_URL=https://lace-proof-pub.preview.midnight.network
