// Confidential Procurement System
// A sealed-bid auction for privacy-preserving procurement
//
// Public state (visible on blockchain):
//   - Procurement requests with deadlines
//   - Status of each procurement (open, closed, awarded)
//   - Winning bidder address (after award)
//   - Bid counts per procurement (but not amounts)
//
// Private state (zero-knowledge, never revealed):
//   - Bid amounts
//   - Bid proposal details
//   - Losing bidder identities

pragma language_version 0.23;
import CompactStandardLibrary;

// ============================================================================
// ENUMS
// ============================================================================

/// Status of a procurement
export enum ProcurementStatus {
    OPEN,
    CLOSED,
    AWARDED
}

/// Win state for tracking auction results
export enum WinState {
    IN_PROGRESS,
    AWARDED
}

// ============================================================================
// LEDGER STATE (Public)
// ============================================================================

/// Organization that created the procurement
export ledger organization: Bytes<32>;

/// Procurement description (public)
export ledger description: Opaque<"string">;

/// Deadline as unix timestamp
export ledger deadline: Uint<64>;

/// Current status of the procurement
export ledger status: ProcurementStatus;

/// Winning bidder (disclosed only after award)
export ledger winner: Bytes<32>;

/// Number of bids received (public count, amounts remain private)
export ledger bidCount: Counter;

/// Win state tracker
export ledger winState: WinState;

// ============================================================================
// WITNESS FUNCTIONS (Private computations)
// ============================================================================

/// Get organization secret key
witness getOrgSk(): Bytes<32>;

/// Get supplier secret key  
witness getSupplierSk(): Bytes<32>;

// ============================================================================
// CIRCUITS
// ============================================================================

/// Create a new procurement request
/// - orgSk: Organization's secret key (private witness)
/// - procDescription: What is being procured (public)
/// - procDeadline: Unix timestamp when bidding closes (public)
export circuit createProcurement(
    orgSk: Bytes<32>,
    procDescription: Opaque<"string">,
    procDeadline: Uint<64>
): [] {
    // Derive and disclose organization address
    const orgPubKey = getDappPubKey(orgSk);
    organization = disclose(orgPubKey);
    
    // Set procurement details (public)
    description = disclose(procDescription);
    deadline = disclose(procDeadline);
    
    // Initialize status
    status = ProcurementStatus.OPEN;
    winState = WinState.IN_PROGRESS;
    // bidCount starts at 0 by default
}

/// Submit a confidential bid
/// - supplierSk: Supplier's secret key (private witness)
/// - bidAmount: The bid amount (PRIVATE - zero-knowledge)
/// - proposalDetails: Proposal text (PRIVATE - zero-knowledge)
/// 
/// Privacy guarantee: The bid amount and proposal details are never 
/// revealed on-chain. Only the bid count is incremented publicly.
export circuit submitBid(
    supplierSk: Bytes<32>,
    bidAmount: Uint<64>,
    proposalDetails: Opaque<"string">
): [] {
    // Verify procurement is open
    assert(status == ProcurementStatus.OPEN, "Procurement is not open");
    
    // Verify bid amount is valid (private check)
    assert(bidAmount > 0, "Invalid bid amount");
    
    // Hash the proposal (private)
    const proposalHash = hashProposal(proposalDetails);
    
    // Increment public bid count (reveals only that a bid was submitted)
    bidCount.increment(1);
    
    // Note: bidAmount and proposalDetails are witnessed but NOT disclosed
    // They remain private throughout the circuit execution
}

/// Close a procurement (can only be done by the organization)
/// - orgSk: Organization's secret key (private witness)
export circuit closeProcurement(orgSk: Bytes<32>): [] {
    // Verify caller is the organization
    const orgPubKey = getDappPubKey(orgSk);
    assert(organization == disclose(orgPubKey), "Not authorized");
    
    // Update status to Closed
    status = ProcurementStatus.CLOSED;
}

/// Award the procurement to a winner
/// - orgSk: Organization's secret key (private witness)
/// - winnerSk: Winning supplier's secret key (private witness)
/// - winningBidAmount: The winning bid (PRIVATE - proven valid but not revealed)
/// 
/// Privacy guarantee: Only the winner address is disclosed. The winning 
/// bid amount remains private but is proven to be the lowest valid bid.
export circuit awardProcurement(
    orgSk: Bytes<32>,
    winnerSk: Bytes<32>,
    winningBidAmount: Uint<64>
): [] {
    // Verify caller is the organization
    const orgPubKey = getDappPubKey(orgSk);
    assert(organization == disclose(orgPubKey), "Not authorized");
    
    // Verify procurement is closed
    assert(status == ProcurementStatus.CLOSED, "Procurement must be closed first");
    
    // Verify bid amount is valid (private check)
    assert(winningBidAmount > 0, "Invalid winning bid amount");
    
    // Disclose winner address (deliberately public)
    const winnerPubKey = getDappPubKey(winnerSk);
    winner = disclose(winnerPubKey);
    
    // Update status
    status = ProcurementStatus.AWARDED;
    winState = WinState.AWARDED;
}

/// Reveal bid details to authorized parties (optional - for transparency)
/// Can be used to reveal bid to auditors or for dispute resolution
/// - supplierSk: Supplier's secret key (private witness)
/// - bidAmount: The bid amount to reveal (PRIVATE until revealed)
/// - auditorPubKey: Address of auditor/arbitrator
export circuit revealBid(
    supplierSk: Bytes<32>,
    bidAmount: Uint<64>,
    auditorPubKey: Bytes<32>
): [] {
    // Verify bid amount is valid
    assert(bidAmount > 0, "Invalid bid amount");
    
    // In production, this would integrate with encrypted storage
    // For now, we prove the bid was valid without public disclosure
    
    // The auditorPubKey could be used for encrypted reveal in production
    const supplierPubKey = getDappPubKey(supplierSk);
}

// ============================================================================
// HELPER CIRCUITS
// ============================================================================

/// Hash a Dapp-specific public key to track user interaction
export circuit getDappPubKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "procurement:pk:"), sk]);
}

/// Hash proposal details
circuit hashProposal(details: Opaque<"string">): Bytes<32> {
    // In production, this would be a proper hash of the proposal
    // For now, we just witness the details without hashing
    // The details are verified to be non-empty through the witness
    return pad(32, "proposal:hash");
}
